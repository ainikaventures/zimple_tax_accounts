# .env.local.example — copy to .env.local for local development.
# .env.local is git-ignored; never commit secrets to the repo.

# ─────────────────────────────────────────────────────────────────────────
# Managed mode (optional) — set these to host a single shared Claude key
# server-side so users don't have to configure their own API keys. Useful
# for letting accountants / testers try the app without setup. Leave both
# unset to use the default bring-your-own-key (BYOK) flow.

# REQUIRED in managed mode. Server-only (not NEXT_PUBLIC_), encrypted at
# rest on Vercel. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# REQUIRED in managed mode. Visible to the client to hide BYOK controls
# and route every chat / PDF-extraction call through the server endpoints.
# Leave unset (or set to anything other than "managed") to use BYOK.
NEXT_PUBLIC_AGENT_MODE=

# ─────────────────────────────────────────────────────────────────────────
# Legacy — Sprint 6 environment variable. Currently unused by the running
# app (every cloud provider is BYOK from the browser, and Ollama is
# default-local). Reserved for future server-side provider routing.
AGENT_PROVIDER=
