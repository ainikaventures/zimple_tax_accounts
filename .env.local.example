# .env.local.example — copy to .env.local for local development.
# .env.local is git-ignored; never commit secrets to the repo.

# Optional. The AI tax-agent feature is disabled when this is unset; the rest
# of the app (parsing, calculation, suggestions, export) still works.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Switches the agent backend. Default: "claude".
# Future value "ollama" will route to a local Ollama instance (not yet
# implemented — stub provider only).
AGENT_PROVIDER=claude
