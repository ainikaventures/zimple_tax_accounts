{
  "name": "uk-tax-advisor",
  "version": "1.1.0",
  "private": true,
  "description": "Source-available UK personal income tax web app — calculation, suggestions, AI assistant, and filing-ready exports. Free for noncommercial use; commercial licence required.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/ainikaventures/zimple_tax_accounts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainikaventures/zimple_tax_accounts.git"
  },
  "bugs": {
    "url": "https://github.com/ainikaventures/zimple_tax_accounts/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run sync-pdf-worker && next dev",
    "build": "npm run sync-pdf-worker && next build",
    "sync-pdf-worker": "cp node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs public/pdf.worker.min.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "for f in tests/*.test.ts; do echo \"\\n→ $f\"; tsx \"$f\" || exit 1; done",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "next": "15.5.18",
    "pdfjs-dist": "^5.7.284",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
}
